# MySQL 8 (local / Railway / managed)
DATABASE_URL="mysql://root:password@localhost:3306/disability_ims"

# JWT signing secret — long random value in production
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
NODE_ENV=development

# Single-service hosting: absolute path to the built frontend (its dist/ folder).
# Leave empty to auto-detect ../disability-ims-frontend/dist. When a build is
# found, the API and the web app are served from the same origin (one deploy).
CLIENT_DIST=

# Dev only: auto-create/alter tables from the models.
# Use migrations in production and keep this false.
DB_SYNC=false

# Estimated PwD population for the coverage metric (Table 3: 2,400 in Kamonyi)
ESTIMATED_PWD_POPULATION=2400

# SMTP for issuing login credentials by email.
# Leave SMTP_HOST empty in dev: emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@disability-ims.rw"

# MySQL 8 (local / Railway / managed)
DATABASE_URL="mysql://root:password@localhost:3306/disability_ims"

# JWT signing secret — long random value in production
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
NODE_ENV=development

# Cross-origin allowlist, comma separated, e.g. "https://ids.kamonyi.gov.rw".
# Only needed when the web app is hosted on a DIFFERENT origin from this API.
# In the default single-service deploy (CLIENT_DIST below) leave it empty.
# Enforced only when NODE_ENV=production.
CORS_ORIGIN=

# Single-service hosting: absolute path to the built frontend (its dist/ folder).
# Leave empty to auto-detect ../disability-ims-frontend/dist. When a build is
# found, the API and the web app are served from the same origin (one deploy).
CLIENT_DIST=

# Dev only: auto-create/alter tables from the models.
# Use migrations in production and keep this false.
DB_SYNC=false

# Estimated PwD population for the coverage metric (Table 3: 2,400 in Kamonyi)
ESTIMATED_PWD_POPULATION=2400

# ── Email notifications ──────────────────────────────────────
# Requirement (Table 3.4): notify users of decisions, deliveries and new
# opportunities by email or message.
#
# MAIL_PROVIDER=gmail → Gmail + App Password (the account needs 2-Step
#                       Verification; a normal password will be rejected).
#                       Generate at https://myaccount.google.com/apppasswords
# MAIL_PROVIDER=smtp  → any SMTP host, configured below.
# unset               → dev mode: every email is printed to the console
#                       instead of being sent, and no workflow is blocked.
MAIL_PROVIDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Link target used by the buttons in outgoing email (the deployed web app).
APP_URL=http://localhost:5173

# Dev safety: send every notification to this one address instead of the real
# recipient (the demo data uses fictional domains, and bounced mail gets a
# sending account throttled). The intended recipient appears in the subject.
# MUST be empty in production.
MAIL_REDIRECT_TO=

# Optional explicit From header; defaults to the Gmail/SMTP identity.
MAIL_FROM=

# Generic SMTP (used only when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@disability-ims.rw"
